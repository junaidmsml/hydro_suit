    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 8px 22px rgba(56, 189, 248, 0.3), inset 0 2px 6px rgba(255, 255, 255, 0.3);
    animation: liquidFlow 4s ease infinite;
    z-index: 1;
    margin-top: 18px;
    width: 100%;
    text-align: center;
    text-decoration: none;
  }

  @keyframes liquidFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .cta-liquid::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.5) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.6s ease;
    transform: scale(0);
    border-radius: 50%;
    z-index: -1;
  }

  .cta-liquid::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 5px; height: 5px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  /* ═══ HOVER: GRADIENT SHIFT + RIPPLE + GLOW ═══ */
  .cta-liquid:hover {
    background: linear-gradient(135deg, #22D3EE, #38BDF8, #A78BFA, #22D3EE);
    background-size: 300% 300%;
    animation: liquidFlow 1.5s ease infinite;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 
      0 15px 40px rgba(34, 211, 238, 0.6),
      0 0 60px rgba(167, 139, 250, 0.4),
      inset 0 2px 8px rgba(255, 255, 255, 0.5);
    letter-spacing: 2px;
    color: #0A1628 !important;
  }

  .cta-liquid:hover::before {
    opacity: 1;
    transform: scale(1.5);
  }

  .cta-liquid:hover::after {
